# Copy to .env and fill in. Existing environment variables always win, so a
# scheduler can override anything here.

# --- credentials ----------------------------------------------------------
# From platform.openai.com. A ChatGPT Plus/Pro subscription does NOT include
# API access -- they are separate products with separate billing.
OPENAI_API_KEY=

# --- providers ------------------------------------------------------------
# mock = no credentials, no cost, procedural placeholder imagery.
# openai = real generation, real money.
IMAGE_PROVIDER=mock
TEXT_PROVIDER=mock

IMAGE_MODEL=gpt-image-2
IMAGE_QUALITY=medium
TEXT_MODEL=gpt-5

# --- output shape ---------------------------------------------------------
SEGMENTS=4
SECONDS_PER_SEGMENT=4.5
LOOP_SHAPE=true
BURN_CAPTIONS=true
OUT_DIR=runs

# --- overrides (usually unnecessary) --------------------------------------
# FFMPEG_BIN=/usr/bin/ffmpeg
# CAPTION_FONT=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf
