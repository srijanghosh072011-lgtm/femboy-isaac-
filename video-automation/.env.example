# Copy to .env and fill in. Existing environment variables always win, so a
# scheduler can override anything here.

# --- credentials ----------------------------------------------------------
# From platform.openai.com. A ChatGPT Plus/Pro subscription does NOT include
# API access -- they are separate products with separate billing.
OPENAI_API_KEY=

# --- providers ------------------------------------------------------------
# mock = no credentials, no cost, procedural placeholder imagery.
# openai = real generation, real money.
IMAGE_PROVIDER=mock
TEXT_PROVIDER=mock

IMAGE_MODEL=gpt-image-2
IMAGE_QUALITY=medium
TEXT_MODEL=gpt-5

# --- output shape ---------------------------------------------------------
SEGMENTS=4
SECONDS_PER_SEGMENT=4.5
LOOP_SHAPE=true
BURN_CAPTIONS=true
OUT_DIR=runs

# --- overrides (usually unnecessary) --------------------------------------
# FFMPEG_BIN=/usr/bin/ffmpeg
# CAPTION_FONT=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf

# --- ranking pipeline (`vidauto rank`) ------------------------------------
# Where clips come from. Pooled across all listed sources.
#   mock    = procedural placeholder, no network, no cost
#   pexels  = free API key, commercial use, no attribution required
#   pixabay = free API key, commercial use, no attribution required
CLIP_SOURCES=mock
PEXELS_API_KEY=
PIXABAY_API_KEY=

# The relevance gate: every candidate clip is checked against the list item
# before it can be used. This is what stops the pipeline illustrating
# "commercial fisherman" with a stock photo of a seafood dinner.
#   mock      = simulated from the mock source's ground truth (no cost)
#   openai    = uses OPENAI_API_KEY
#   anthropic = uses ANTHROPIC_API_KEY
VISION_PROVIDER=mock
VISION_MODEL=gpt-5
ANTHROPIC_API_KEY=

# 0-10. 7 demands a clear depiction; below that is "related but indirect",
# which is what slop looks like.
VERIFY_THRESHOLD=7
# Cost ceiling per list item.
MAX_VISION_CHECKS=8
CANDIDATES_PER_QUERY=10

RANK_ITEMS=5
SECONDS_PER_ITEM=3.5

# Every clip ever used, so no video reuses footage from an earlier one.
# Back this up -- losing it means losing the no-reuse guarantee.
LEDGER_PATH=clip-ledger.json
